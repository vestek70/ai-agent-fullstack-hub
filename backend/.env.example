# AI Agent Fullstack Hub - Environment Variables
# If keys are omitted, the local high-fidelity agent engine runs automatically out of the box!

# Google Gemini API Key (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Nous Hermes / OpenAI Compatible endpoint (optional)
HERMES_API_KEY=your_hermes_or_together_api_key_here
HERMES_API_BASE=https://api.together.xyz/v1

# Server Port
PORT=8000
HOST=0.0.0.0
